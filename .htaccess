Options -Indexes

# ── URL CANONICALISATION (preserve existing 301 redirects) ──────────────────
RewriteEngine On
RewriteRule ^casualwear\.html$ casual.html [R=301,L,QSA]
RewriteRule ^corporatewear\.html$ corporate.html [R=301,L,QSA]
RewriteRule ^weekendwear\.html$ weekend.html [R=301,L,QSA]
RewriteRule ^dresswear\.html$ dresses.html [R=301,L,QSA]
RewriteRule ^backend/api/(.*)$ api/$1 [L,QSA]

# Redirect index.html → / (avoid duplicate content)
RewriteCond %{THE_REQUEST} /index\.html [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ api/index.php [L,QSA]

# ── SECURITY HEADERS (also improves Google trust signals) ───────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ── GZIP COMPRESSION (Core Web Vitals — reduces page weight) ────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf font/woff font/woff2
</IfModule>

# ── BROWSER CACHING (Core Web Vitals — faster repeat visits) ────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    # HTML — short cache so updates propagate quickly
    ExpiresByType text/html "access plus 1 hour"
    # CSS & JS — long cache (use versioning query strings when updating)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    # Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    # Sitemap & robots
    ExpiresByType application/xml "access plus 1 day"
    ExpiresByType text/plain "access plus 1 day"
</IfModule>

# ── MIME TYPE CORRECTIONS (prevent rendering issues) ────────────────────────
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType image/webp .webp
    AddType application/json .json
</IfModule>

