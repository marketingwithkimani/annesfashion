{
  // ─────────────────────────────────────────────────────────────
  // Production Worker: client-api
  // ─────────────────────────────────────────────────────────────
  // This file defines the production configuration for the client-api Worker.
  // It contains D1 and R2 bindings for production resources only.
  //
  // IMPORTANT: Do NOT put secrets or API keys in this file.
  //            Use `npx wrangler secret put SECRET_NAME` instead.
  //
  // If a wrangler.jsonc or wrangler.toml already exists for this Worker,
  // MERGE these bindings into the existing config rather than replacing it.
  // ─────────────────────────────────────────────────────────────

  "name": "client-api",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-11",

  // D1 database binding (production)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "client-production",
      "database_id": "REPLACE_WITH_ACTUAL_D1_PRODUCTION_ID_FROM_SETUP_OUTPUT"
    }
  ],

  // R2 bucket bindings (production)
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "client-production-images"
    },
    {
      "binding": "FILES",
      "bucket_name": "client-production-files"
    },
    {
      "binding": "BACKUPS",
      "bucket_name": "client-production-backups"
    }
  ]
}
