# =====================================================
# Anne's Fashion Line — Environment Configuration (Template)
# =====================================================

# Supabase Project URL & Keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key_here
SUPABASE_SECRET_KEY=your_service_role_secret_key_here

# Supabase Database Configuration
DB_TYPE=pgsql
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASS=your_supabase_db_password_here

# Application & Auth Settings
JWT_SECRET=your_jwt_secret_key_here
APP_ENV=development
